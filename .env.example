APP_ENV=development
APP_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
AUTH_MODE=mock
AUTH_COOKIE_SECURE=false
DATABASE_URL=postgres://optitrace_login:local-app-only@localhost:5432/optitrace?sslmode=disable
MIGRATION_DATABASE_URL=postgres://postgres:local-postgres-only@localhost:5432/optitrace?sslmode=disable
SIMULATOR_URL=http://localhost:8090
MOCK_ISSUER=http://localhost:8090
MOCK_INTERNAL_URL=http://localhost:8090
API_BASE_URL=http://localhost:8080
# Hosted profile: Vercel + Render Free + Supabase. Follow the hosting runbook.
# Hosted APP_ENV=production and AUTH_MODE=supabase. No MOCK_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# SUPABASE_SECRET_KEY and DATABASE_URL belong only in the Go service.
# Dedicated development Google Cloud project only. Never use production identity credentials locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IDENTITY_PLATFORM_API_KEY=
GOOGLE_CLOUD_PROJECT=
